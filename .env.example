# Modelo das variáveis de ambiente.
# Copie este arquivo para .env.local e preencha os valores (o .env.local NUNCA vai para o GitHub).
# Cada prompt do guia diz quando e onde pegar cada chave.

# Endereço do sistema
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — painel do Supabase > Project Settings > API Keys
# URL do projeto: Project Settings > Data API (ou o botão Connect no topo)
NEXT_PUBLIC_SUPABASE_URL=
# Chave "Publishable" (começa com sb_publishable_) — pode ir para o navegador
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave "Secret" (começa com sb_secret_) — SECRETA, nunca mostre a ninguém
SUPABASE_SECRET_KEY=

# Resend — e-mails (Prompt 15)
RESEND_API_KEY=
EMAIL_REMETENTE=vistorias@envio.seudominio.com.br

# WhatsApp (Prompt 16) — provedor: wame (grátis) | meta | zapi
WHATSAPP_PROVEDOR=wame
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Asaas — mensalidade por Pix ou cartão, liberada sozinha pelo webhook.
# Sem ASAAS_API_KEY, o sistema continua no Pix manual (chave Pix da tabela "plataforma").
# Chave da API: painel do Asaas > Integrações > Chaves de API. SECRETA, só no servidor.
#   Sandbox (testes) começa com $aact_hmlg_ ; produção com $aact_prod_
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3   Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Senha do webhook (32 a 255 caracteres, sem espaços). A MESMA digitada no painel do Asaas > Integrações > Webhooks
ASAAS_WEBHOOK_TOKEN=
# Endereço público do sistema (volta da fatura do cartão)
APP_URL=https://www.vistoriarapida.digital

# Sentry — alertas de erro (Prompt 26)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Vercel Cron (avisos automáticos)
CRON_SECRET=
