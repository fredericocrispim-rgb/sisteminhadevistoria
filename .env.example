# Modelo das variáveis de ambiente.
# Copie este arquivo para .env.local e preencha os valores (o .env.local NUNCA vai para o GitHub).
# Cada prompt do guia diz quando e onde pegar cada chave.

# Endereço do sistema
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Prompt 03) — painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — e-mails (Prompt 15)
RESEND_API_KEY=
EMAIL_REMETENTE=vistorias@envio.seudominio.com.br

# WhatsApp (Prompt 16) — provedor: wame (grátis) | meta | zapi
WHATSAPP_PROVEDOR=wame
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Pagamento: na fase de validação é SÓ PIX, sem intermediário.
# A chave Pix fica na tabela "plataforma" (cadastrada no /admin), não aqui.
# (Asaas fica para depois: ASAAS_API_KEY, ASAAS_BASE_URL, ASAAS_WEBHOOK_TOKEN)

# Sentry — alertas de erro (Prompt 26)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Vercel Cron (avisos automáticos)
CRON_SECRET=
